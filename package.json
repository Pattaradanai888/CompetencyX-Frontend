{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:e2e": "vitest run --project e2e",
    "test:nuxt": "vitest run --project nuxt",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/ui": "^4.4.0",
    "@vueuse/core": "^14.0.0",
    "nuxt": "^4.4.2",
    "tailwindcss": "^4.1.15",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "motion-v": "^1.7.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.15.2",
    "@nuxt/test-utils": "^4.0.2",
    "@vueuse/nuxt": "^14.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.2.0",
    "happy-dom": "^20.9.0",
    "playwright-core": "^1.59.1",
    "prettier": "^3.8.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.4",
    "vue-mess-detector": "^0.68.0"
  }
}
