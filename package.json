{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:e2e": "vitest run --project e2e",
    "test:nuxt": "vitest run --project nuxt",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/ui": "^4.7.0",
    "@vueuse/core": "^14.3.0",
    "motion-v": "^2.2.1",
    "nuxt": "^4.4.5",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.34",
    "vue-router": "^5.0.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@nuxt/eslint": "1.15.2",
    "@nuxt/test-utils": "^4.0.3",
    "@vue/test-utils": "^2.4.10",
    "@vueuse/nuxt": "^14.3.0",
    "eslint": "^10.3.0",
    "happy-dom": "^20.9.0",
    "playwright-core": "^1.60.0",
    "prettier": "^3.8.3",
    "vitest": "^4.1.6",
    "vue-mess-detector": "^0.68.1"
  }
}
